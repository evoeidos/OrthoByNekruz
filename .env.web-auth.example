# Web auth / Telegram Login Widget (публичные — видны в браузере)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=OrthoByNekruz
NEXT_PUBLIC_CHANNEL_USERNAME=nzsdental

# Вход через Telegram (OIDC) — кнопка "Войти через Telegram" на экране входа.
# Получить: @BotFather → бот → Login Widget. Client Secret НЕ коммитить и не
# присылать в чат — только через env переменные хостинга (Timeweb → Настройки
# → Переменные окружения). В тех же настройках BotFather нужно зарегистрировать:
#   Redirect URI:     <APP_URL>/api/auth/telegram-oidc/callback
#   Trusted Origin:   <APP_URL>
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=

# Секрет подписи cookie-сессии (лучше отдельный; иначе используется BOT_TOKEN)
SESSION_SECRET=

# Письма для сброса пароля (Resend). Без ключа ссылка только в логах сервера.
RESEND_API_KEY=
EMAIL_FROM=ByNekruz <onboarding@resend.dev>
APP_URL=https://nekruz2000n-eng-orthobynekruz-a9a4.twc1.net

# Шифрование паролей/сессий привязки КрасГМУ (мин. 16 символов; лучше 32+ случайных)
KRASGMU_ENCRYPTION_KEY=

# Вход на krasgmu.ru идёт через headless-браузер (puppeteer-core) — сайт за DDoS-Guard
# и не пропускает обычный fetch()-логин. Браузер выполняется не локально на сервере
# (рантайм-образ Timeweb не тянет системные библиотеки Chromium), а удалённо через
# Browserless — нужен один из двух вариантов ниже.
# Токен: дашборд Browserless → API Key.
BROWSERLESS_TOKEN=
# Либо сразу готовый wss-адрес (если регион/эндпоинт отличается от стандартного) —
# имеет приоритет над BROWSERLESS_TOKEN.
# BROWSERLESS_WS_ENDPOINT=

# Timeweb / обычный Redis (TCP, через ioredis) — приоритетнее Upstash REST
# REDIS_HOST=your-redis-host
# REDIS_PORT=6379
# REDIS_USERNAME=default
# REDIS_PASSWORD=your-password
# или одной строкой: REDIS_URL=redis://default:password@host:6379
