# Переменные окружения ByNekruz. Значения задаются в Timeweb →
# App Platform → evoeidos → Настройки → Переменные окружения.
# Секреты сюда не вписывать и не коммитить.

# ── Telegram ────────────────────────────────────────────────────────────────
BOT_TOKEN=
# Владелец: админка, уведомления о чеках, алерты о сбоях
ADMIN_TG_ID=
# Секрет вебхука бота; после смены — node scripts/set-webhook.mjs (консоль Timeweb)
TELEGRAM_WEBHOOK_SECRET=
# Канал, подписка на который нужна для входа
CHANNEL_USERNAME=nzsdental
NEXT_PUBLIC_CHANNEL_USERNAME=nzsdental
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Вход на сайте через Telegram (OIDC): @BotFather → бот → Login Widget.
# Redirect URI: <APP_URL>/api/auth/telegram-oidc/callback
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
# Прокси для Bot API, если api.telegram.org недоступен с сервера (необязательно)
# TELEGRAM_API_BASE=

# ── Приложение ──────────────────────────────────────────────────────────────
APP_URL=https://nekruz2000n-eng-orthobynekruz-a9a4.twc1.net
# Подпись cookie веб-сессии (если пусто — используется BOT_TOKEN)
SESSION_SECRET=
# Второй фактор админ-API (основная защита — initData + ADMIN_TG_ID).
# NEXT_PUBLIC_ADMIN_SECRET должен совпадать с ADMIN_SECRET.
ADMIN_SECRET=
# NEXT_PUBLIC_ADMIN_SECRET=

# ── Redis (единственное хранилище) ─────────────────────────────────────────
# Timeweb: TCP через ioredis (приоритетнее Upstash)
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=
# или одной строкой: REDIS_URL=redis://default:password@host:6379
# Запасной вариант — Upstash REST: UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN

# ── ИИ ──────────────────────────────────────────────────────────────────────
# Timeweb AI Gateway (DeepSeek) — основной; Groq и Gemini — запасные (необязательно)
TIMEWEB_AI_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=

# ── КрасГМУ ─────────────────────────────────────────────────────────────────
# Шифрование паролей и сессий студентов (мин. 16 символов, лучше 32+ случайных)
KRASGMU_ENCRYPTION_KEY=
# Удалённый браузер для входа на krasgmu.ru (сайт за DDoS-Guard)
BROWSERLESS_TOKEN=
# BROWSERLESS_WS_ENDPOINT=

# ── Сборка ──────────────────────────────────────────────────────────────────
# Хеш коммита для сброса кэша контента у студентов (если git на сборке нет —
# берётся время сборки)
# GIT_COMMIT_SHA=
